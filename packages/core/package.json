{
  "name": "jobsite-math",
  "version": "0.1.0",
  "description": "Zero-dependency US construction and contractor calculators: roof pitch, hip roof, concrete, gravel, brick, mortar, paint, drywall, deck boards, markup and hourly rate.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["construction", "contractor", "calculator", "roof-pitch", "concrete", "gravel", "drywall", "paint", "brick", "markup", "estimating", "us-units"],
  "homepage": "https://github.com/johnski9000/jobsite-math#readme",
  "repository": { "type": "git", "url": "git+https://github.com/johnski9000/jobsite-math.git", "directory": "packages/core" },
  "bugs": { "url": "https://github.com/johnski9000/jobsite-math/issues" },
  "license": "MIT",
  "author": "JW Digital Services Ltd",
  "engines": { "node": ">=18" }
}
